{
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(mkdir:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm run:*)",
      "Bash(grep:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "deepwiki",
    "playwright",
    "context7"
  ],
  "skillOverrides": {
    "agents-sdk": "off",
    "durable-objects": "off",
    "workers-best-practices": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "sandbox-sdk": "off",
    "sandbox-stable": "off",
    "sandbox-next": "off",
    "sandbox-migrate-to-next": "off",
    "turnstile-spin": "off",
    "data:analyze": "off",
    "data:build-dashboard": "off",
    "data:create-viz": "off",
    "data:data-context-extractor": "off",
    "data:data-visualization": "off",
    "data:explore-data": "off",
    "data:sql-queries": "off",
    "data:statistical-analysis": "off",
    "data:validate-data": "off",
    "data:write-query": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "cloudflare": "off",
    "wrangler": "off",
    "web-perf": "off",
    "commit": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-sensitive-files.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "claude-security@claude-plugins-official": true
  },
  "language": "日本語",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true
}
