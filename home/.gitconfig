[user]
	email = ysti2019.win2020.st@gmail.com
	name = newt
	signingkey = F997C11AB42E6408
[core]
	excludesfile = ~/.gitignore
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[diff]
	algorithm = histogram
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	program = gpg
	format = openpgp
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[url "git@github.com:"]
	insteadOf = https://github.com/
# 署名方式などマシン固有の上書き。存在しなければ無視される
[include]
	path = ~/.gitconfig.local
