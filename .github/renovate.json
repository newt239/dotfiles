{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am on saturday"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "ffmpeg"
      ],
      "overrideDatasource": "github-tags",
      "overridePackageName": "FFmpeg/FFmpeg",
      "extractVersion": "^n(?<version>\\d+\\.\\d+(\\.\\d+)?)$"
    }
  ]
}
